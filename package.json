{
  "name": "@cantelop/sdk",
  "version": "1.5.0",
  "description": "Backend integration and Session runtime SDK for Cantelop applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepandel/cantelop-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/stepandel/cantelop-sdk/issues"
  },
  "homepage": "https://github.com/stepandel/cantelop-sdk#readme",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./harnesses/claude": {
      "types": "./dist/harnesses/claude.d.ts",
      "import": "./dist/harnesses/claude.js"
    },
    "./harnesses/claude/Dockerfile": "./dist/harnesses/claude/Dockerfile",
    "./harnesses/claude/protocol": {
      "types": "./dist/harnesses/claude-protocol.d.ts",
      "import": "./dist/harnesses/claude-protocol.js"
    },
    "./harnesses/native": {
      "types": "./dist/harnesses/native.d.ts",
      "import": "./dist/harnesses/native.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --all",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && pnpm test:built",
    "test:built": "node --test test/*.test.mjs",
    "test:native": "cd native && go test ./... github.com/stepandel/cantelop/fire-fuse/workspacesync github.com/stepandel/cantelop/fire-fuse/syncprotocol",
    "check:examples": "pnpm build && pnpm check:examples:built",
    "check:examples:built": "pnpm --filter './examples/**' --if-present check && node scripts/check-examples.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:bun": "pnpm build && bun test test/bun/subprocess.test.mjs",
    "prepare": "node scripts/build.mjs --all"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "imports": {
    "#cantelop-sync": {
      "node": "./dist/sync-node.js",
      "default": "./dist/sync-unavailable.js"
    },
    "#cantelop-app-config": {
      "node": "./dist/app-config-node.js",
      "default": "./dist/app-config-empty.js"
    }
  }
}
