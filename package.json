{
  "name": "@cantelop/sdk",
  "version": "0.9.1",
  "description": "Provider-neutral API and Session runtime SDK for Cantelop applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepandel/cantelop-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/stepandel/cantelop-sdk/issues"
  },
  "homepage": "https://github.com/stepandel/cantelop-sdk#readme",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    }
  },
  "files": [
    "dist",
    "docs/database.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "check:examples": "pnpm build && pnpm --filter './examples/**' --if-present check && node scripts/check-examples.mjs",
    "check:package": "pnpm build && node scripts/check-package.mjs",
    "prepack": "pnpm build",
    "test:bun": "pnpm build && bun test test/bun-subprocess.test.mjs",
    "check:database-types": "pnpm build && tsc --noEmit --strict --types node --module nodenext --moduleResolution nodenext --target es2022 test/database-types.ts && tsc --noEmit --strict --skipLibCheck --types node --module nodenext --moduleResolution nodenext --target es2022 test/drizzle-database-types.ts"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "esbuild": "^0.25.0",
    "miniflare": "5.20260804.1-alpha",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "drizzle-orm": "0.45.2",
    "typescript": "^5.6.3"
  }
}
