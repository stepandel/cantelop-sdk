{
  "name": "@cantelop/example-web-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "check": "tsc -p tsconfig.json --noEmit && node --check public/chat.js",
    "start": "node dist/server.js",
    "dev": "pnpm build && pnpm start"
  },
  "dependencies": {
    "@cantelop/sdk": "workspace:*",
    "@openai/agents": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.3",
    "esbuild": "^0.25.0"
  }
}
